# ==============================================================================
# REKSA System Environment Configuration (.env.example)
# Salin file ini menjadi .env untuk menjalankan sistem secara lokal / produksi:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Untuk development lokal standalone tanpa Docker:
# DATABASE_URL=sqlite:///./reksa.db
# Untuk Docker Compose lokal:
# DATABASE_URL=postgresql://reksa:reksa_dev_password@localhost:5432/reksa
# Untuk Neon Serverless Postgres Cloud:
DATABASE_URL=postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@<host-direct>/neondb?sslmode=require
NEON_BRANCH=production

# ------------------------------------------------------------------------------
# 2. MQTT BROKER CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Mosquitto lokal (port 1883 tanpa TLS)
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_ID=reksa-backend
MQTT_ACK_ENABLED=true
MQTT_DEDUP_MAX_MESSAGES=5000

# Untuk HiveMQ Cloud (TLS port 8883):
# MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USERNAME=reksa-backend
# MQTT_PASSWORD=your_secure_password
# MQTT_TLS=true

# ------------------------------------------------------------------------------
# 3. AI ADVISORY & FORECASTING ENGINE
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8100
AI_TIMEOUT_SECONDS=2.0
AI_WINDOW_SECONDS=10.0
AI_MIN_SAMPLES=2
REKSA_FORECAST_MODEL=/app/models/near_miss_forecaster.joblib
REKSA_PRIORITY_MODEL=/app/models/priority_engine.joblib

# ------------------------------------------------------------------------------
# 4. VOICE NLU (WIT.AI) SPEECH-TO-TEXT
# ------------------------------------------------------------------------------
# Server Access Token dari dashboard Wit.ai (bahasa Indonesia / Inggris)
WIT_AI_TOKEN=

# ------------------------------------------------------------------------------
# 5. BACKEND RUNTIME & SECURITY
# ------------------------------------------------------------------------------
APP_ENV=development
DEVICE_OFFLINE_TIMEOUT=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ------------------------------------------------------------------------------
# 6. FRONTEND WEB DASHBOARD (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/live

# ------------------------------------------------------------------------------
# 7. CLOUD INGESTION & BRIDGE (Opsional - GCP Pub/Sub & Firestore)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC=reksa-telemetry
BRIDGE_ID=reksa-gateway-01
OUTBOX_PATH=/data/outbox.db
FIRESTORE_ENABLED=false
FIRESTORE_COLLECTION=reksa_ingest_events
