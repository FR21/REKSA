APP_ENV=development
DATABASE_URL=sqlite:///./reksa.db
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_ID=reksa-backend
MQTT_ACK_ENABLED=true
MQTT_DEDUP_MAX_MESSAGES=5000
FIRESTORE_ENABLED=false
GOOGLE_CLOUD_PROJECT=
FIRESTORE_COLLECTION=reksa_ingest_events
AI_SERVICE_URL=http://localhost:8100
AI_TIMEOUT_SECONDS=2
AI_WINDOW_SECONDS=10
AI_MIN_SAMPLES=2
CORS_ORIGINS=["http://localhost:5173"]
DEVICE_OFFLINE_TIMEOUT=30
