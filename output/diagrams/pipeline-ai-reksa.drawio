        <mxCell id="edge-model-eval" value="Bandingkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="model-group" target="evaluation"><mxGeometry relative="1" as="geometry"/></mxCell>
