        <mxCell id="edge-eval-chart" value="Isi setelah eksperimen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.5;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontFamily=Arial;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="evaluation" target="chart-placeholder"><mxGeometry relative="1" as="geometry"/></mxCell>
