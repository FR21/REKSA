        <mxCell id="safety-note" value="&lt;b&gt;BATAS KESELAMATAN:&lt;/b&gt; AI hanya membantu prioritas pemeriksaan. Alarm lokal tetap dikendalikan oleh aturan pada Smart Helmet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=Arial;fontSize=11;fontColor=#000000;spacing=8;arcSize=6;" vertex="1" parent="1">
