        </mxCell>
        <mxCell id="alarm" value="&lt;b&gt;ALARM LOKAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Buzzer dan vibration motor memberi peringatan langsung kepada pekerja&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#991B1B;strokeWidth=3;fontFamily=Arial;fontSize=14;fontColor=#111111;spacing=12;arcSize=10;" vertex="1" parent="1">
