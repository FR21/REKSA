        <mxCell id="hazard" value="&lt;b&gt;ACTIVE HAZARD NODE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Memancarkan identitas sumber bahaya melalui BLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#111111;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="210" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="helmet" value="&lt;b&gt;SMART HELMET NODE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mendeteksi zona dan mengambil keputusan alarm secara lokal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#111111;spacing=12;arcSize=10;" vertex="1" parent="1">
