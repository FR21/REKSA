        </mxCell>
        <mxCell id="offline-note" value="&lt;b&gt;OFFLINE-FIRST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Kegagalan Wi-Fi, MQTT, gateway, backend, AI, atau cloud tidak mematikan alarm lokal.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontFamily=Arial;fontSize=15;fontColor=#111111;spacing=14;arcSize=10;" vertex="1" parent="1">
